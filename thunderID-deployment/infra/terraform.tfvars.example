# Copy to terraform.tfvars and replace the placeholders before tofu apply.
aws_region      = "us-east-1"
name_prefix     = "thunderid"
domain_name     = "auth.example.com"
route53_zone_id = "REPLACE_WITH_YOUR_HOSTED_ZONE_ID"

control_plane_type = "t4g.small"
worker_type        = "t4g.small"
data_type          = "t4g.small"
kubernetes_minor   = "v1.36"
